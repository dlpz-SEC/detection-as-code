# Wazuh Manager API - functional detection testing (Tier 2)
#
# Copy to .env (git-ignored) and fill in your lab values.
# The manager API listens on port 55000 (NOT the Indexer's 9200).
# Credentials were set at install time (see wazuh-passwords.txt /
# wazuh-install-files.tar on the VM); the API user is often "wazuh-wui".

DAC_WAZUH_API_HOST=https://192.168.127.129:55000
DAC_WAZUH_API_USER=your-api-user
DAC_WAZUH_API_PASS=your-api-password

# The manager ships a self-signed certificate; "false" is accepted only for
# localhost / RFC1918 lab addresses.
DAC_WAZUH_API_VERIFY_SSL=false
