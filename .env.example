# Wazuh Manager API - functional detection testing (Tier 2)
#
# Copy to .env (git-ignored) and fill in your lab values.
# The manager API listens on port 55000 (NOT the Indexer's 9200).
# Credentials were set at install time (see wazuh-passwords.txt /
# wazuh-install-files.tar on the VM); the API user is often "wazuh-wui".

DAC_WAZUH_API_HOST=https://YOUR_WAZUH_VM_IP:55000
DAC_WAZUH_API_USER=your-api-user
DAC_WAZUH_API_PASS=your-api-password

# The manager ships a self-signed certificate; "false" is accepted only for
# localhost / RFC1918 lab addresses.
DAC_WAZUH_API_VERIFY_SSL=false

# Azure Sentinel deployment (Phase 4) - scripts/deploy_sentinel_rules.py
#
# Target workspace. Subscription/RG/workspace identify where the parser function
# and analytics rules are pushed.
DAC_SENTINEL_SUBSCRIPTION_ID=your-subscription-guid
DAC_SENTINEL_RESOURCE_GROUP=sc200-lab-rg
DAC_SENTINEL_WORKSPACE_NAME=law-sc200-sentinel

# Auth: leave the SP trio blank to use your interactive `az login` (az CLI).
# Set all three to deploy headless (CI) via a service principal that holds
# Microsoft Sentinel Contributor (write) on the workspace - NOT the Log Analytics
# Reader SP ADTE uses (that is read-only and cannot deploy).
DAC_SENTINEL_TENANT_ID=
DAC_SENTINEL_CLIENT_ID=
DAC_SENTINEL_CLIENT_SECRET=
