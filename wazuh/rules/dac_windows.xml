<!--
  Detection-as-Code: native Wazuh twins of the production Sigma rules.

  Contract: wazuh/rule_map.yml binds each rule here to its Sigma source by
  UUID + MITRE technique; tests/test_rule_map.py fails CI if they drift.
  Fidelity rule: these replicate Sigma semantics VERBATIM. Improvements go
  to the Sigma rule first, then get re-ported here.

  Field names (win.eventdata.*) and the built-in Sysmon parent IDs
  (61612 = Event 10 ProcessAccess, 61603 = Event 1 ProcessCreate) are
  confirmed against the live manager during the Phase-0 logtest spike -
  adjust here if that spike reports different values for your Wazuh version.

  Custom ID allocation: blocks of 10 per Sigma rule.
    10010x - lsass_memory_access        (sigma 9e8f2a3b-...)
    10011x - powershell_encoded_command (sigma a5c8d2e1-...)
-->
<group name="dac,windows,sysmon,">

  <!--
    Twin of rules/windows/credential_access/lsass_memory_access.yml
    (sigma id 9e8f2a3b-1c4d-5e6f-7a8b-9c0d1e2f3a4b, level high -> 12).
    condition: selection_target AND selection_access_rights
               AND NOT (filter_av_products OR filter_system_processes
                        OR filter_wmiprvse OR filter_backup_tools)
    All four Sigma filters constrain the same field (SourceImage), so each
    becomes one negated field match; negated fields AND together, which is
    exactly NOT(A OR B OR C OR D).
  -->
  <rule id="100100" level="12">
    <if_sid>61612</if_sid>
    <!-- selection_target: TargetImage|endswith '\lsass.exe' -->
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <!-- selection_access_rights: GrantedAccess|contains -->
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)0x1010|0x1410|0x1F1FFF|0x1FFFFF|0x143A</field>
    <!-- filter_av_products: SourceImage|contains -->
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)\\MsMpEng\.exe|\\MsSense\.exe|\\SenseIR\.exe|\\csfalconservice\.exe|\\cb\.exe</field>
    <!-- filter_system_processes: SourceImage|startswith -->
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)^C:\\Windows\\System32\\(svchost|wininit|lsass|csrss)\.exe</field>
    <!-- filter_wmiprvse: startswith System32\ AND endswith \WmiPrvSE.exe (same field: one regex) -->
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)^C:\\Windows\\System32\\(.*\\)?WmiPrvSE\.exe$</field>
    <!-- filter_backup_tools: SourceImage|contains -->
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)\\VeeamAgent|\\Veritas|\\CommVault</field>
    <description>DAC: Suspicious LSASS memory access from $(win.eventdata.sourceImage)</description>
    <mitre>
      <id>T1003</id>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!--
    Twin of rules/windows/execution/powershell_encoded_command.yml
    (sigma id a5c8d2e1-3f4b-5a6c-7d8e-9f0a1b2c3d4e, level medium -> 10).
    condition: selection_powershell AND selection_encoded AND selection_suspicious_combo
               AND NOT (filter_sccm OR filter_azure OR filter_intune OR filter_dsc)
    filter_azure/filter_intune/filter_dsc are single-field -> negated fields.
    filter_sccm spans TWO fields (ParentImage AND CommandLine); negated fields
    cannot express NOT(A AND B), so it is the level-0 suppression child 100111.
  -->
  <rule id="100110" level="10">
    <if_sid>61603</if_sid>
    <!-- selection_powershell: Image|endswith -->
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <!-- selection_encoded: CommandLine|contains ' -enc ' variants (literal spaces preserved) -->
    <field name="win.eventdata.commandLine" type="pcre2">(?i) -(encodedcommand|enc|ec|en|e) </field>
    <!-- selection_suspicious_combo: CommandLine|contains -->
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-nop|-noni|-w hidden|-windowstyle h|-ep bypass|-exec bypass</field>
    <!-- filter_azure + filter_intune: ParentImage|contains -->
    <field name="win.eventdata.parentImage" negate="yes" type="pcre2">(?i)\\waappagent\.exe|\\WindowsAzureGuestAgent\.exe|\\Microsoft\.Management\.Services</field>
    <!-- filter_dsc: CommandLine|contains -->
    <field name="win.eventdata.commandLine" negate="yes" type="pcre2">(?i)Start-DscConfiguration</field>
    <description>DAC: PowerShell encoded command with suspicious flags on $(win.system.computer)</description>
    <mitre>
      <id>T1059</id>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>execution,</group>
  </rule>

  <!-- filter_sccm suppression: ParentImage ccmexec.exe AND CommandLine -ExecutionPolicy.
       Level 0 = match swallowed, no alert. Landing here is the filter WORKING. -->
  <rule id="100111" level="0">
    <if_sid>100110</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\ccmexec\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-ExecutionPolicy</field>
    <description>DAC suppression: SCCM-managed encoded PowerShell (filter_sccm)</description>
  </rule>

</group>
